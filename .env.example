PORT=3000
# Set this to a long, random value before deploying. Never commit your real .env file.
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_HOURS=8
# Optional, one-time setup secret for POST /api/auth/bootstrap. Remove after the first President account is created.
BOOTSTRAP_ADMIN_SECRET=
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Planova ClubOps AI Configuration
# Providers: local (built-in deterministic intelligence), gemini, openai, claude
AI_PROVIDER=local
AI_MODEL=gemini-1.5-pro
AI_API_KEY=
# Autonomy levels: ASK_ALWAYS, ASK_FOR_RISKY, AUTO
AI_AUTONOMY=ASK_FOR_RISKY
